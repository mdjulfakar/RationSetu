

{
  "expo": {
    "name": "RationSetu",
    "slug": "rationsetu",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/rationsetu-icon.png",
    "android": {
      "package": "in.rationsetu.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/rationsetu-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "RationSetu को राशन के सामान की फोटो चुनने की अनुमति दें।",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
